# ══════════════════════════════════════════════════════════════════
# AgentBazaar Configuration
# HSK Chain Horizon Hackathon Mumbai Edition
# ══════════════════════════════════════════════════════════════════

# 1. AI Integration (Gemini)
# Obtain from https://aistudio.google.com/
# Server-side only: never exposed to browser client
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2. Database (Prisma ORM)
# Default is local SQLite for instant zero-dependency execution.
# For production PostgreSQL: postgresql://user:password@localhost:5432/agentbazaar
DATABASE_URL="file:./dev.db"

# 3. HashKey Chain (HSK Chain) Network Parameters
# Mainnet Chain ID: 177 | Testnet Chain ID: 133
NEXT_PUBLIC_HSK_CHAIN_ID=177
NEXT_PUBLIC_HSK_CHAIN_NAME="HashKey Chain Mainnet"
NEXT_PUBLIC_HSK_RPC_URL="https://mainnet.hsk.xyz"
NEXT_PUBLIC_HSK_EXPLORER_URL="https://hashkey.blockscout.com"
NEXT_PUBLIC_HSK_CURRENCY_SYMBOL="HSK"
NEXT_PUBLIC_HSK_CURRENCY_NAME="HashKey Token"
NEXT_PUBLIC_HSK_DECIMALS=18

# Official Mainnet Token Contracts (per docs.hashkeychain.net)
NEXT_PUBLIC_WHSK_ADDRESS="0xB210D2120d57b758EE163cFfb43e73728c471Cf1"
NEXT_PUBLIC_USDC_ADDRESS="0x054ed45810DbBAb8B27668922D110669c9D88D0a"
NEXT_PUBLIC_USDT_ADDRESS="0xf1b50ed67a9e2cc94ad3c477779e2d4cbfff9029"

# Deployed Smart Contract (AgentBazaarEscrow)
# When deployed, set the address here:
NEXT_PUBLIC_AGENT_BAZAAR_CONTRACT_ADDRESS="0x742d35Cc6634C0532925a3b844Bc454e4438f44e"

# 4. HashKey Settlement Protocol (HSP) Configuration
# API docs: https://hashkey-merchant.github.io/#/
# Hosts: QA: https://merchant-qa.hashkeymerchant.com | Production: https://hsp.hashkey.com
HSP_GATEWAY_URL="https://merchant-qa.hashkeymerchant.com"
HSP_APP_KEY="ak_agentbazaar_demo"
HSP_APP_SECRET="sec_agentbazaar_hsk_hackathon_2026"
HSP_MERCHANT_NAME="AgentBazaar Protocol"
HSP_MERCHANT_PRIVATE_KEY=""
HSP_SANDBOX_MODE="true"

# 5. Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
